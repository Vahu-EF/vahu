{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/**/src/**/*.ts",
    "apps/**/tests/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/tests/**/*.ts",
    "packages/**/scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "**/coverage/**"]
}
