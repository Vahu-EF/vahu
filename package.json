{
  "name": "vahu-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VAHU — an agent-agnostic engineering framework for AI-assisted software development.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter vahu dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:workspace": "node scripts/validation/validate-workspace.mjs",
    "validate:standards": "node scripts/validation/validate-standards.mjs",
    "validate:profiles": "node scripts/validation/validate-profiles.mjs",
    "validate:workflows": "node scripts/validation/validate-workflows.mjs",
    "validate:docs": "node --import tsx scripts/validation/validate-docs.mjs",
    "release:pack": "tsx scripts/release/validate-artifacts.ts --pack",
    "release:validate": "tsx scripts/release/validate-artifacts.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:workspace && pnpm validate:standards && pnpm validate:profiles && pnpm validate:workflows && pnpm validate:docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
