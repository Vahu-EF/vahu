{
  "name": "@vahu-ef/adapters",
  "version": "0.1.0",
  "description": "Provider adapters that render canonical VAHU agent definitions.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/Vahu-EF/vahu/tree/main/packages/adapters",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vahu-EF/vahu.git",
    "directory": "packages/adapters"
  },
  "bugs": {
    "url": "https://github.com/Vahu-EF/vahu/issues"
  },
  "keywords": [
    "vahu",
    "agents",
    "adapters"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vahu-ef/schemas": "workspace:*"
  }
}
