{
  "name": "@vahu-ef/core",
  "version": "0.1.0",
  "description": "Reusable validation and diagnostics logic for VAHU projects.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/Vahu-EF/vahu/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vahu-EF/vahu.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Vahu-EF/vahu/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vahu-ef/schemas": "workspace:*"
  }
}
