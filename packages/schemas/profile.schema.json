{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^PROFILE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "category": {
      "type": "string",
      "enum": ["backend", "frontend", "mobile", "database", "infrastructure", "api", "testing"]
    },
    "technology": {
      "type": "string",
      "minLength": 1
    },
    "supportedVersions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projectTypes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "const": "all"
          },
          {
            "type": "string",
            "enum": [
              "web-application",
              "mobile-application",
              "desktop-application",
              "backend-service",
              "library",
              "cli",
              "other"
            ]
          }
        ]
      }
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PROFILE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
      }
    },
    "related": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PROFILE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
      }
    },
    "architecture": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structure": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conventions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "testing": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "security": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "documentation": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tooling": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compatibility": {
      "default": {
        "conflictsWith": []
      },
      "type": "object",
      "properties": {
        "conflictsWith": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PROFILE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["conflictsWith"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "category",
    "technology",
    "supportedVersions",
    "projectTypes",
    "prerequisites",
    "related",
    "architecture",
    "structure",
    "conventions",
    "testing",
    "security",
    "documentation",
    "tooling",
    "checks",
    "compatibility"
  ],
  "additionalProperties": false
}
