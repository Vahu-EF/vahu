{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "vahu": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": ["version"],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "targetUsers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "type": {
          "type": "string",
          "enum": [
            "web-application",
            "mobile-application",
            "desktop-application",
            "backend-service",
            "library",
            "cli",
            "other"
          ]
        },
        "languages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "slug",
        "description",
        "purpose",
        "targetUsers",
        "type",
        "languages",
        "scope",
        "constraints"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved"]
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "not-applicable"]
        },
        "assets": {
          "type": "object",
          "properties": {
            "logo": {
              "type": "string",
              "minLength": 1
            },
            "colors": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "typography": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "guidelines": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["colors", "typography"],
          "additionalProperties": false
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "designSystem": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-started", "pending-approval", "approved", "not-applicable"]
        },
        "source": {
          "type": "string",
          "enum": ["existing", "generated", "none"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["status", "source"],
      "additionalProperties": false
    },
    "repositories": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["monorepo", "multi-repository", "hybrid"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["strategy"],
      "additionalProperties": false
    },
    "technology": {
      "type": "object",
      "properties": {
        "backend": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frontend": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mobile": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "database": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "infrastructure": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testing": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deployment": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "backend",
        "frontend",
        "mobile",
        "database",
        "infrastructure",
        "testing",
        "deployment"
      ],
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": ["generic"],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["generic", "codex", "claude-code", "gemini"]
          }
        },
        "configuration": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["enabled", "configuration"],
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["incomplete", "ready", "blocked"]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["status", "notes"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "vahu",
    "project",
    "identity",
    "brand",
    "designSystem",
    "repositories",
    "technology",
    "agents",
    "readiness"
  ],
  "additionalProperties": false
}
