{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^AGENT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "instructions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "scope": {
            "type": "string",
            "enum": ["project", "repository", "path", "package"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "scope", "text"],
        "additionalProperties": false
      }
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    "commands": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      }
    },
    "workflows": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["name", "steps"],
        "additionalProperties": false
      }
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "approval": {
            "default": "always",
            "type": "string",
            "enum": ["always", "on-write", "never"]
          }
        },
        "required": ["name", "required", "approval"],
        "additionalProperties": false
      }
    },
    "context": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    "approvals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compatibility": {
      "default": {
        "adapters": []
      },
      "type": "object",
      "properties": {
        "adapters": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["generic", "codex", "claude-code", "gemini"]
          }
        }
      },
      "required": ["adapters"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "instructions",
    "rules",
    "skills",
    "commands",
    "workflows",
    "tools",
    "context",
    "approvals",
    "compatibility"
  ],
  "additionalProperties": false
}
